{
  "name": "software-engineering-school-testcase-2026",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "test": "jest --verbose",
    "test:unit": "jest --testPathPatterns=unit --verbose",
    "test:integration": "jest --testPathPatterns=integration --verbose",
    "test:e2e": "playwright test",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "proto:lint": "buf lint",
    "proto:generate": "buf generate",
    "proto:sync": "cp proto/notification/v1/notification.proto notification-service/grpc/notification.proto",
    "bench:rest": "node benchmark/rest-autocannon.js",
    "bench:transports": "node benchmark/compare-transports.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.{js,json,yml,yaml,html,md}": "prettier --write"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.3",
    "@grpc/grpc-js": "^1.13.3",
    "@grpc/proto-loader": "^0.7.15",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "resend": "^4.5.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "__tests__/integration/setup/",
      "notification-service/",
      "/e2e/"
    ]
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.47.2",
    "@bufbuild/protoc-gen-es": "^2.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testcontainers/postgresql": "^11.13.0",
    "autocannon": "^8.0.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-prettier": "^5.4.0",
    "globals": "^17.5.0",
    "husky": "^9.1.0",
    "jest": "^30.3.0",
    "lint-staged": "^15.4.0",
    "prettier": "^3.5.0",
    "supertest": "^7.2.2"
  }
}
