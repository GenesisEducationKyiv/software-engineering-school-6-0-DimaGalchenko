PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/release_notifier
BASE_URL=http://localhost:3000

GITHUB_TOKEN=

SCAN_CRON=*/1 * * * *

REDIS_URL=redis://localhost:6379
CACHE_TTL=600
API_KEY=
GRPC_PORT=50051

# Internal API port (unpublished; reachable only within the Docker network)
INTERNAL_PORT=3100

# Kafka broker used for cross-service messaging
KAFKA_BROKER=localhost:9092

# Notification service env (used by notification-service)
EMAIL_PROVIDER=nodemailer
EMAIL_FROM=
EMAIL_USER=
EMAIL_PASS=
RESEND_API_KEY=
